# Optional AI provider. Without one, Cat Track runs entirely on its offline rule engine.

# Option 1: any OpenAI-compatible endpoint. Groq (fast, free tier ~8k tokens/min per model):
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b
AI_DOC_MODEL=qwen/qwen3.8-27b   # document library; a separate model = a separate rate-limit bucket
AI_AGENT_MODE=tools             # multi-turn tool calling (use "rag" on slow endpoints)
# NVIDIA alternative: AI_BASE_URL=https://integrate.api.nvidia.com/v1  AI_MODEL=z-ai/glm-5.3-flash  AI_AGENT_MODE=rag
# AI_REASONING=on        # let reasoning models think longer (slower, more tokens)
# AI_EXTRA_BODY={}       # extra JSON merged into every request
# AI_SYNC_TIMEOUT_MS=15000 # how long a report waits for AI understanding before the rule engine takes over
# AI_STT_MODEL=whisper-large-v3-turbo # speech to text for voice notes (automatic on Groq; "off" to use the browser's own recognition)
# AI_TIMEOUT_MS=120000   # background AI call timeout
# AI_CONTEXT_CHARS=12000 # context sent to the agent in one call
# AI_VISION=1            # send report photos to the model, if it accepts images

# Option 2: Anthropic (used only when AI_BASE_URL is not set)
# ANTHROPIC_API_KEY=
# CAT_TRACK_MODEL=claude-opus-5-5

# PORT=3000
# CAT_TRACK_DB=./data/cattrack.db
